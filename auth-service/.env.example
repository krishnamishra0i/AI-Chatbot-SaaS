# MongoDB connection URI (replace <password> & <dbname>)
MONGODB_URI=mongodb+srv://krishnamishra_db_user:<db_password>@cluster0.7tidgax.mongodb.net/athena_auth?retryWrites=true&w=majority

# JWT secret
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=1h

# Nodemailer (SMTP) settings or SendGrid SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-smtp-user
EMAIL_PASS=your-smtp-pass
EMAIL_FROM="Athena <no-reply@yourdomain.com>"

# Google OAuth (create in Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# OTP settings
OTP_LENGTH=6
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_LOCK_MINUTES=15

# Rate limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5

# App
PORT=4000

# Optional: disable real email sending in dev
DISABLE_EMAIL=false
